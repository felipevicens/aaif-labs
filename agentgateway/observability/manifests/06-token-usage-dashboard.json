{
  "annotations": {},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Headline (selected range)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Sum of all tokens (input + output) across the selected time range, honouring the namespace/team/model/API-key filters above.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "id": 9101,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Prompt / input tokens over the range (gen_ai_token_type=\"input\").",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "id": 9102,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", gen_ai_token_type=\"input\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Input Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Generated / output tokens over the range (gen_ai_token_type=\"output\") — usually the bigger driver of load on local models.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "id": 9103,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", gen_ai_token_type=\"output\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Output Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Number of LLM requests observed over the range (the _count of the token-usage histogram).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 1
      },
      "id": 9104,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_count{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Total Requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Total tokens divided by total requests — how heavy the average call is.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 9105,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\"}[$__range])) / sum(increase(agentgateway_gen_ai_client_token_usage_count{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\"}[$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Avg Tokens / Request",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 0,
      "panels": [],
      "title": "Who's burning tokens (ranking)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Teams ranked by total tokens over the selected range. The label comes from the CEL metrics policy (apiKey.team).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 9110,
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (team) (increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", team!=\"\"}[$__range])))",
          "legendFormat": "{{team}}",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top Teams by tokens",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Individual API keys (user_id) ranked by total tokens. user_id is high-cardinality — this ranking is the right place for it, a drill-down rather than a top-level series.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 9111,
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (user_id) (increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", user_id!=\"\"}[$__range])))",
          "legendFormat": "{{user_id}}",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Top API Keys by tokens",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Models ranked by total tokens over the range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "id": 9112,
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
