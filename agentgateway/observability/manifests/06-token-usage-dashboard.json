      },
      "targets": [
        {
          "expr": "sum by (team) (increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", team!=\"\"}[$__interval]))",
          "legendFormat": "{{team}}",
          "refId": "A"
