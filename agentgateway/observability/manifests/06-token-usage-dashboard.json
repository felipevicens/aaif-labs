    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "The single 'who's burning tokens' view: every (team × API key × model) combination over the selected range, ranked by tokens. Click the Tokens header to re-sort.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 9113,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Tokens",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (team, user_id, gen_ai_request_model) (increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\", team!=\"\"}[$__range]))",
          "format": "table",
          "queryType": "instant",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "team": "Team",
              "user_id": "API Key (user_id)",
              "gen_ai_request_model": "Model",
              "Value": "Tokens"
            }
          }
        }
      ],
      "title": "Top consumers (team × API key × model)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
