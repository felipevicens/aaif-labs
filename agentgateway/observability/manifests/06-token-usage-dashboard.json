      "targets": [
        {
          "expr": "topk(10, sum by (gen_ai_request_model) (increase(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"${namespace:pipe}\", team=~\"${team:pipe}\", user_id=~\"${user_id:pipe}\", gen_ai_request_model=~\"${model:pipe}\"}[$__range])))",
          "legendFormat": "{{gen_ai_request_model}}",
